# ---------------------------------------------------------------------------------------------
# CONVEX (primary backend). Keys are set as Convex environment variables, NOT in this file:
#   npx convex env set ANTHROPIC_API_KEY 'sk-ant-...'
#   npx convex env set CARTESIA_API_KEY 'sk_car_...'
#   npx convex env set CARTESIA_VOICE_ID_EN '...'
#   npx convex env set CARTESIA_VOICE_ID_ES '...'
#   (optional) npx convex env set CLAUDE_MODEL 'claude-haiku-5-5'
# `npx convex dev` writes CONVEX_DEPLOYMENT and CONVEX_URL to .env.local (git-ignored).
# Put CONVEX_URL into ios/Buddy/Config/Secrets.xcconfig for the iOS app.
# ---------------------------------------------------------------------------------------------
# LOCAL NODE SERVER (backend/: serves the web app; fallback for development). Copy to .env.
# Copy to .env (never commit .env). The backend reads these; the iOS app never holds API keys.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.6
# Pick voices in the Cartesia playground; use a voice that sounds natural in each language.
CARTESIA_VOICE_ID_EN=
CARTESIA_VOICE_ID_ES=

# Optional: a shared token the iOS app sends as X-Buddy-Client. Leave EMPTY for the web app.
BUDDY_CLIENT_TOKEN=
PORT=8787
RATE_LIMIT_PER_MINUTE=120
