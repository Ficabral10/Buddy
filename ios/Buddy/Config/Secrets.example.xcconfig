// Copy to Secrets.xcconfig (git-ignored) and fill in. No API keys here: they live in Convex env vars.
DEVELOPMENT_TEAM =
// xcconfig treats // as a comment, so write URLs with $(SLASH):
SLASH = /
// From `npx convex dev` (.env.local CONVEX_URL). Leave empty to run fully on LocalBackend.
CONVEX_URL = https:$(SLASH)$(SLASH)your-deployment-123.convex.cloud
