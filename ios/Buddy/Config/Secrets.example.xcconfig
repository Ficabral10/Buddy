// Copy to Secrets.xcconfig (git-ignored) and fill in. No API keys here: keys live on the backend.
DEVELOPMENT_TEAM =
// xcconfig treats // as a comment, so write URLs with $(SLASH): http:$(SLASH)$(SLASH)your-mac.local:8787
SLASH = /
BUDDY_BACKEND_URL = http:$(SLASH)$(SLASH)your-mac.local:8787
BUDDY_CLIENT_TOKEN =
